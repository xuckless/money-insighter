# Stack-level secrets for docker-compose.yml. Copy to .env (git-ignored).
# Each service also has its own .env: plaid-backend-golang/.env and
# postgres-topper/.env (see their .env.example files).

# Password of the plaidsync superuser role in the Compose Postgres. Hex keeps
# it safe inside a connection URL. openssl rand -hex 24
POSTGRES_PASSWORD=<openssl rand -hex 24>

# Password of the topper role, created on the first boot of the postgres
# volume by postgres-topper/deploy/postgres-init/01-topper.sh. openssl rand -hex 24
TOPPER_DB_PASSWORD=<openssl rand -hex 24>

# Tailscale auth key for the sidecar (admin console -> Settings -> Keys).
# Needed on first boot only; the node's state persists in a volume.
TS_AUTHKEY=<tskey-auth-...>
