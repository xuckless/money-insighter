# plaidsync configuration
#
# Copy this file to .env (git-ignored) and replace every <placeholder>.
# `make run` sources .env as shell, so keep lines in KEY=value form and quote
# any value that contains spaces or shell metacharacters. Each variable below
# is read by internal/config; the "default" is what applies when a variable
# is unset or empty. The loader rejects any required variable still set to
# its <placeholder>, so an unedited copy, or one forgotten line, cannot start
# the service.
#
# Never commit .env. It holds the database password, the API bearer token,
# the Plaid secret and the key that encrypts bank access tokens.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Address the HTTP server listens on (host:port). Keep it on loopback unless a
# TLS-terminating reverse proxy sits in front; the service itself speaks
# plain HTTP. Default: 127.0.0.1:8080
PLAIDSYNC_BIND_ADDR=127.0.0.1:8080

# Postgres connection string (pgx URL or key=value DSN). Required.
# This value matches the local Compose database in docker-compose.yml.
PLAIDSYNC_DATABASE_URL=postgres://plaidsync:plaidsync@127.0.0.1:5433/plaidsync?sslmode=disable

# Static bearer token every /v1/* request must present. Required, at least
# 32 bytes. Generate one with: openssl rand -hex 32
PLAIDSYNC_API_TOKEN="<openssl rand -hex 32>"

# How long graceful shutdown waits for in-flight requests after SIGINT or
# SIGTERM. Go duration syntax. Default: 30s
PLAIDSYNC_SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Access token encryption (AES-256-GCM key encryption key)
# ---------------------------------------------------------------------------

# Version number under which new Plaid access tokens are encrypted. Bump it
# when you rotate the key. Default: 1 (must be greater than 0)
PLAIDSYNC_KEK_VERSION=1

# The key encryption key for PLAIDSYNC_KEK_VERSION: base64 of exactly 32
# random bytes. Required. Losing this key makes every stored access token
# unreadable. Generate with: openssl rand -base64 32
PLAIDSYNC_KEK="<base64 of 32 random bytes: openssl rand -base64 32>"

# Older keys still needed to decrypt rows written before a rotation, as
# comma-separated "version:base64" pairs, e.g. "1:AAAA...,2:BBBB...". Versions
# must differ from PLAIDSYNC_KEK_VERSION. Optional; default: none.
PLAIDSYNC_KEK_PREVIOUS=

# ---------------------------------------------------------------------------
# Plaid credentials (dashboard.plaid.com -> Team Settings -> Keys)
# ---------------------------------------------------------------------------

# Plaid client ID. Required.
PLAID_CLIENT_ID="<your Plaid client_id>"

# Plaid secret for the environment in PLAID_ENV. Required.
PLAID_SECRET="<your Plaid sandbox secret>"

# Plaid environment: sandbox or production. Develop against sandbox; every
# production Item counts against the Trial plan cap. Default: sandbox
PLAID_ENV=sandbox

# ---------------------------------------------------------------------------
# Plaid Link
# ---------------------------------------------------------------------------

# OAuth redirect URI registered in the Plaid dashboard, needed only when a
# client runs Plaid Link itself (CIBC uses the OAuth flow). Must be an
# absolute https URL; http is accepted only for localhost. Not needed for
# the Hosted Link routes, which the desktop app uses. Optional; default: none.
PLAIDSYNC_REDIRECT_URI=

# Public URL Plaid delivers webhooks to: this service's POST
# /v1/webhooks/plaid as reachable from the internet. Absolute URL; https is
# required when PLAID_ENV=production. Optional; default: none, in which case
# syncs run only on the scheduler and manual triggers and the service warns
# at startup. The desktop app leaves it unset: a laptop has no public URL.
PLAIDSYNC_WEBHOOK_URL=

# Comma-separated ISO 3166-1 country codes for Link. CA is required for
# Canadian institutions. Default: CA
PLAIDSYNC_COUNTRY_CODES=CA

# Comma-separated Plaid products Link must obtain consent for. Default:
# transactions
PLAIDSYNC_PRODUCTS=transactions

# Comma-separated products used only when the institution supports them,
# e.g. liabilities. Optional; default: none.
PLAIDSYNC_REQUIRED_IF_SUPPORTED_PRODUCTS=

# Comma-separated products the user may decline during Link. Optional;
# default: none.
PLAIDSYNC_OPTIONAL_PRODUCTS=

# Comma-separated products Link gathers consent for without initialising
# them (e.g. liabilities), so they can be enabled later without a second
# Link session. Optional; default: none.
PLAIDSYNC_ADDITIONAL_CONSENTED_PRODUCTS=

# Days of transaction history requested at Link time, 1..730. Default: 730
PLAIDSYNC_TRANSACTIONS_DAYS_REQUESTED=730

# Application name shown inside Link. Default: plaidsync
PLAIDSYNC_LINK_CLIENT_NAME=plaidsync

# Two-letter language code for the Link UI. Default: en
PLAIDSYNC_LINK_LANGUAGE=en

# Plaid's user.client_user_id sent with every Link token. The deployment is
# single-tenant, so one constant value is enough. Default: plaidsync
PLAIDSYNC_LINK_CLIENT_USER_ID=plaidsync

# ---------------------------------------------------------------------------
# Sync engine and scheduler
# ---------------------------------------------------------------------------

# Debounce for manually triggered syncs: a trigger arriving sooner than this
# after a successful sync is answered from the database without calling
# Plaid. 0 disables the debounce. Default: 15m
PLAIDSYNC_SYNC_MIN_INTERVAL=15m

# How often the in-process scheduler syncs every active item. Default: 6h
PLAIDSYNC_SYNC_INTERVAL=6h

# Whether the in-process scheduler runs at all (true/false). Default: true
PLAIDSYNC_SCHEDULER_ENABLED=true

# Attempts per run before a retryable Plaid error is given up on until the
# next scheduled run. Default: 5 (at least 1)
PLAIDSYNC_SYNC_MAX_ATTEMPTS=5

# Initial backoff between retry attempts; grows exponentially with jitter.
# Default: 2s
PLAIDSYNC_SYNC_RETRY_BASE=2s

# Upper bound on the backoff between attempts. Must be at least
# PLAIDSYNC_SYNC_RETRY_BASE. Default: 2m
PLAIDSYNC_SYNC_RETRY_MAX=2m

# How many items the scheduler syncs in parallel. Default: 2 (at least 1)
PLAIDSYNC_SYNC_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level: debug, info, warn or error. Default: info
PLAIDSYNC_LOG_LEVEL=info

# Log encoding: json or text. Default: json
PLAIDSYNC_LOG_FORMAT=json
