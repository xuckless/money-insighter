{
  "name": "money-insighter",
  "productName": "Money Insighter",
  "version": "0.1.0",
  "description": "Personal finance desktop app: your bank accounts and transactions, synced from Plaid into a local database",
  "private": true,
  "main": "./out/main/index.js",
  "author": "xuckless",
  "license": "UNLICENSED",
  "scripts": {
    "build:go": "node scripts/build-go.mjs",
    "build:go:all": "node scripts/build-go.mjs --all",
    "dev": "npm run build:go && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "dist:linux": "npm run build:go && npm run build && electron-builder --linux",
    "dist:win": "node scripts/build-go.mjs --os windows && node scripts/fetch-postgres.mjs windows-x64 && npm run build && electron-builder --win",
    "dist": "npm run build:go:all && node scripts/fetch-postgres.mjs windows-x64 && npm run build && electron-builder --linux --win",
    "fetch:postgres": "node scripts/fetch-postgres.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.12.0",
    "lucide-react": "^1.46.0",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  },
  "homepage": "https://github.com/xuckless/money-insighter"
}
