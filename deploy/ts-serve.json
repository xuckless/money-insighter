{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": { "Proxy": "http://127.0.0.1:8080" },
        "/plaidsync/": { "Proxy": "http://plaidsync:8080" }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/v1/webhooks/plaid": { "Proxy": "http://plaidsync:8080/v1/webhooks/plaid" }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:8443": true
  }
}
