# topper configuration
#
# Copy this file to .env (git-ignored) and replace every <placeholder>.
# `make run` sources .env as shell, so keep lines in KEY=value form and quote
# any value that contains spaces or shell metacharacters. Each variable below
# is read by internal/config; the "default" is what applies when a variable
# is unset or empty. The loader rejects any required variable still set to
# its <placeholder>, so an unedited copy cannot start the service.
#
# Never commit .env. It holds the database password and the API tokens.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Address the HTTP server listens on (host:port). In the production stack the
# Tailscale sidecar terminates HTTPS and proxies to this address inside the
# shared network namespace, so loopback is correct there too.
# Default: 127.0.0.1:8080
TOPPER_BIND_ADDR=127.0.0.1:8080

# Postgres connection string for the topper role (pgx URL or key=value DSN).
# Required. This value matches the local plaidsync Compose database after
# `make db-init-topper` has created the role with password "topper".
TOPPER_DATABASE_URL=postgres://topper:topper@127.0.0.1:5433/plaidsync?sslmode=disable

# How long graceful shutdown waits for in-flight requests after SIGINT or
# SIGTERM. Go duration syntax. Default: 30s
TOPPER_SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Callers
# ---------------------------------------------------------------------------

# Comma-separated "name:scope:token" entries, one per caller. scope is read
# (GET only) or readwrite (also POST and DELETE). Tokens must be at least 32
# bytes; generate each with: openssl rand -hex 32. The name appears in the
# access log, the token never does. Required.
TOPPER_API_KEYS="<categoriser:read:openssl rand -hex 32,annotator:readwrite:openssl rand -hex 32>"

# Comma-separated tables in schema "topper" exposed read-write under
# /v1/{table}. Each must exist when the service starts. The plaidsync tables
# are always exposed read-only and cannot be listed here. Default: none
TOPPER_WRITE_TABLES=

# Exact browser origins allowed to call the API (scheme://host[:port]),
# comma-separated. Unset disables CORS headers entirely, which is right when
# only services call the topper. Default: none
TOPPER_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# How long a GET of a read-only table or view is answered from memory before
# the database is asked again. 0 disables the cache. Writable tables are never
# cached. Default: 30s
TOPPER_CACHE_TTL=30s

# Upper bound on every database call made for one request. Default: 15s
TOPPER_QUERY_TIMEOUT=15s

# How long startup waits for plaidsync's tables to appear before failing, so
# the topper can start alongside plaidsync in one Compose stack. 0 checks
# once. Default: 60s
TOPPER_STARTUP_WAIT=60s

# Largest POST body accepted, in bytes. Default: 5242880 (5 MiB)
TOPPER_MAX_BODY_BYTES=5242880

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level: debug, info, warn or error. Default: info
TOPPER_LOG_LEVEL=info

# Log encoding: json or text. Logs go to stderr. Default: json
TOPPER_LOG_FORMAT=json
